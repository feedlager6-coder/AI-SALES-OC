modules = ["nodejs-20", "web", "bash", "nix", "postgresql-16"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Workers"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && NEXT_PUBLIC_API_URL=\"\" INTERNAL_API_URL=\"http://localhost:3001\" pnpm dev --port 5000"
waitForPort = 5000

[[workflows.workflow]]
name = "API Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --daemonize yes --port 6379 --save '' --appendonly no > /tmp/redis.log 2>&1; sleep 1; cd apps/api && pnpm dev"
waitForPort = 3001

[[workflows.workflow]]
name = "Workers"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sleep 4 && cd apps/workers && pnpm dev"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 6379
externalPort = 3000

[userenv]

[userenv.shared]
BETTER_AUTH_URL = "http://localhost:3001"
LOG_LEVEL = "info"
NODE_ENV = "development"
REDIS_URL = "redis://localhost:6379"
BETTER_AUTH_SECRET = "eaa2d03612ae8ea4c9bc1382e2e03b4da61418f2a13cd0a2ba06fa8dd98e08ef57b11eb1c28f1b482bd4170446673509"
ENCRYPTION_KEY = "65363210103256ea9ed9ea0d494dba339b4a78c20d292c9a25593f767f936797"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000
